# riftcards-bot configuration
#
# All variables are namespaced; the only one without a namespace is
# TELEGRAM_BOT_TOKEN, which the underlying telegraf library reads
# directly. Copy to .env and fill in the secrets. .env is gitignored.

# --- Required ---

TELEGRAM_BOT_TOKEN=your_bot_token_here

# Which card data source the bot talks to. Must be set; the bot
# fails fast at startup if this is missing or unrecognised. See
# ADR-0004.
CARD_SOURCE=riftapi

# Base URL of the chosen card source. Required.
# Examples: http://riftapi:8080  (same-host Docker)
#           https://riftcodex.example.com  (self-hosted fallback)
RIFTAPI_BASE_URL=
# RIFTCODEX_BASE_URL=                  # only required when CARD_SOURCE=riftcodex

# --- Optional (defaults shown) ---

NODE_ENV=development
PORT=8080
# WEBHOOK_URL=https://your-app.example.com  # set for webhook mode; omit for polling

# --- API behavior ---

API_TIMEOUT_MS=10000
API_RETRY_ATTEMPTS=3

# --- Events adapters ---
#
# Defaults point at Seville, Spain, with a 50 mi / 7-day window.

# RIFTBOUND_V2_BASE_URL=https://api.riftbound.uvsgames.com/api/v2
# RIFTFOUND_BASE_URL=https://www.riftfound.com/api
# EVENTS_LATITUDE=37.39
# EVENTS_LONGITUDE=-5.99
# EVENTS_RADIUS_KM=80
# EVENTS_DAYS_AHEAD=7

# --- Background event watcher ---

# NEXUS_WATCHER_ENABLED=true
# NEXUS_WATCHER_INTERVAL_MS=30000
# ADMIN_TELEGRAM_IDS=123456789,987654321

# --- Per-user settings store (ADR-0006) ---
#
# Path to the SQLite database that holds per-TelegramUser settings
# (currently the saved location for /events). The default is the
# in-container path; mount a Docker volume there to persist across
# restarts and image rebuilds. Set to ':memory:' for ephemeral
# in-process storage (intended for tests only).
#
# USER_SETTINGS_DB_PATH=/data/riftbot.db

# --- Nexus Table (player pairing tracker) ---
#
# URL for the Nexus Table API, hosted as a Netlify function. The
# default is live. NEXUS_TABLE_API_TOKEN is only needed if the
# Netlify function requires bearer auth (unlikely for read calls).
#
# NEXUS_TABLE_API_URL=https://riftboundtoolkit.netlify.app/.netlify/functions/nexus-table
# NEXUS_TABLE_API_TOKEN=
